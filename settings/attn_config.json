{
    "data_dir": "owl_data",
    "checkpoint_dir": "model_checkpoints",
    "exports_dir": "exports",

    "drop": 0.0,
    "embed_sz": 64,
    "batch_sz": 512,
    "data_split": [1.0, 0.0],
    "spec_height": 750,
    "learning_rate": 5e-6,
    "train_epochs": 110,
    "use_attn": true,
    "default_model": "model.attn.v4_3584.datapoints_110.epochs",

    "max_freq": 750,
    "n_fft": 4096,
    "hop_length": 1024,

    "zero_threshold": 0.7,
    "min_call_len": 10, 
    "max_call_len": 200,

    "hop_sizes": [20, 40, 60, 80, 100, 200, 300, 500],
    "base_window_width": 20,

    "axis_correction": 1.2,
    "debug": true,
    "device": "cuda"
}